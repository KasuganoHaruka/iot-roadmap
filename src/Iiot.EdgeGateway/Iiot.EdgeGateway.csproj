<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <UserSecretsId>iiot-edge-gateway</UserSecretsId>
    <!-- 树莓派发布:dotnet publish -c Release -r linux-arm64 (加 self-contained 开关) -->
    <RuntimeIdentifiers>linux-arm64;linux-x64;win-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="Polly" Version="8.4.2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Iiot.Abstractions\Iiot.Abstractions.csproj" />
    <ProjectReference Include="..\Iiot.Drivers.Modbus\Iiot.Drivers.Modbus.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="tags.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
